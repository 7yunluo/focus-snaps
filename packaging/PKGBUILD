# FocusSnapS 的 Arch 包，源码来自本地打好的 tarball（见 build-pkg.sh）
pkgname=focus-snaps
pkgver=0.4.1
pkgrel=1
pkgdesc="Wayland 截图与标注工具（多显示器 / 分数缩放 / 窗口选择）"
arch=('x86_64')
license=('MIT')
depends=('gtk4' 'gtk4-layer-shell' 'libnotify')
makedepends=('rust' 'cargo')
optdepends=(
  'wl-clipboard: 复制到剪贴板更可靠（不依赖键盘焦点）'
  'niri: 窗口选择与显示器信息需要它的 IPC'
)
source=("focus-snaps-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/focus-snaps-$pkgver"
  cargo build --release --locked
}

package() {
  cd "$srcdir/focus-snaps-$pkgver"
  install -Dm755 target/release/FocusSnapS "$pkgdir/usr/bin/FocusSnapS"
  install -Dm644 packaging/focus-snaps.desktop \
    "$pkgdir/usr/share/applications/focus-snaps.desktop"
  install -Dm644 packaging/focus-snaps.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/focus-snaps.svg"
  install -Dm644 packaging/focus-snaps-256.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/focus-snaps.png"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
